# Google Gemini (required for scoring + generation)
# Passed to containers at RUNTIME via docker-compose `env_file:` — never
# baked in as a build arg, so rotating the key never requires a rebuild.
GEMINI_API_KEY=

# Optional cost control: caches the scoring system prompts (the official
# band descriptor tables — large, static, re-sent on every scoring call)
# server-side via the Gemini API's explicit context caching, instead of
# re-sending the full text on every request. Off by default — every layer
# falls back to sending the prompt inline on any caching failure, but this
# has not been exercised against a live Gemini API key in development, so
# verify it in a real environment before relying on it. See
# lib/gemini/contextCache.ts.
GEMINI_CONTEXT_CACHING=

# --- Postgres ---
# Used both by the `db` service itself and to build the DATABASE_URL that
# docker-compose.yml injects into the `migrate` and `app` services (host
# is always the "db" service name there, never localhost).
POSTGRES_USER=bandup
POSTGRES_PASSWORD=bandup
POSTGRES_DB=bandup

# Only used when running `npm run dev` / `npm test` / `npx prisma ...`
# directly on the host, outside docker compose (there is no "db" DNS name
# outside the compose network).
DATABASE_URL=postgresql://bandup:bandup@localhost:5432/bandup

# --- Optional: `queue` compose profile (redis) ---
REDIS_URL=redis://redis:6379

# --- Optional: `storage` compose profile (minio, S3-compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio
MINIO_PORT=9000

# --- Speaking module ---
# STT (word-level timestamps + confidence) — required for /api/speaking/*.
DEEPGRAM_API_KEY=

# Object storage for recorded audio. Leave all S3_* unset to use the local-
# filesystem dev fallback (./storage/audio, served via
# /api/storage/audio/[...key]) — no external service needed. Set S3_BUCKET
# to switch to a real S3-compatible endpoint (AWS S3, Cloudflare R2, or the
# MinIO instance from the `storage` compose profile above — in that case
# S3_ENDPOINT=http://minio:9000, S3_ACCESS_KEY_ID=$MINIO_ROOT_USER,
# S3_SECRET_ACCESS_KEY=$MINIO_ROOT_PASSWORD).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# Optional: real phoneme-level Pronunciation scoring (Azure Speech
# Pronunciation Assessment). Leave unset to use the LLM-derived "estimated"
# Pronunciation band instead — the app works fully either way.
AZURE_SPEECH_KEY=

