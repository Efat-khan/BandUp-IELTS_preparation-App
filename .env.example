# Google Gemini (required for scoring + generation)
# Passed to containers at RUNTIME via docker-compose `env_file:` — never
# baked in as a build arg, so rotating the key never requires a rebuild.
GEMINI_API_KEY=

# --- Postgres ---
# Used both by the `db` service itself and to build the DATABASE_URL that
# docker-compose.yml injects into the `migrate` and `app` services (host
# is always the "db" service name there, never localhost).
POSTGRES_USER=bandup
POSTGRES_PASSWORD=bandup
POSTGRES_DB=bandup

# Only used when running `npm run dev` / `npm test` / `npx prisma ...`
# directly on the host, outside docker compose (there is no "db" DNS name
# outside the compose network).
DATABASE_URL=postgresql://bandup:bandup@localhost:5432/bandup

# --- Optional: `queue` compose profile (redis) ---
REDIS_URL=redis://redis:6379

# --- Optional: `storage` compose profile (minio, S3-compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio
MINIO_PORT=9000

# --- Added in later phases ---
# STT (Whisper/Deepgram/AssemblyAI) keys
# Auth (Clerk) keys
