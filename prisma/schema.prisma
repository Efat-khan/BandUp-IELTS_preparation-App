// BandUp data model (spec §11: users, questions, submissions, scores,
// feedback, progress).
//
// Accuracy invariants encoded here:
// - Score.score is the UNROUNDED sub-score (Decimal) — the officially
//   rounded band is computed in lib/scoring and only ever DISPLAYED.
// - Scores are stored per criterion per pass (double-pass scoring);
//   disagreement between passes flags the submission instead of averaging.
// - Every criterion score carries evidence quoted from the candidate's answer.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Module {
  WRITING
  SPEAKING
}

enum TaskType {
  WRITING_TASK1_ACADEMIC
  WRITING_TASK1_GENERAL
  WRITING_TASK2
  SPEAKING_PART1
  SPEAKING_PART2
  SPEAKING_PART3
}

// Writing Task 2: TR (Task Response); Writing Task 1: TA (Task Achievement)
// Shared: CC, LR, GRA. Speaking: FC (Fluency & Coherence), LR, GRA, PR (Pronunciation)
enum Criterion {
  TR
  TA
  CC
  LR
  GRA
  FC
  PR
}

enum QuestionSource {
  SEED
  GENERATED
}

enum TestType {
  ACADEMIC
  GENERAL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum LetterRegister {
  FORMAL
  SEMI_FORMAL
  INFORMAL
}

enum MockSessionStatus {
  IN_PROGRESS
  SUBMITTED
  SCORED
}

enum PronunciationSource {
  /**
   * A real phoneme-level pronunciation API (e.g. Azure Pronunciation Assessment) was configured and used.
   */
  MEASURED
  /**
   * No pronunciation API configured — derived from the LLM's own audio-informed PR band instead.
   */
  ESTIMATED
}

enum SubmissionStatus {
  PENDING
  SCORING
  SCORED
  FLAGGED // double-pass disagreement — needs review before display
  FAILED
}

enum FeedbackKind {
  STRENGTHS
  IMPROVEMENTS
  REWRITE
  EXAMINER_COMMENT
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  authProviderId String?  @unique // Clerk user id (wired in auth phase)
  targetBand     Decimal? @db.Decimal(2, 1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submissions Submission[]
  progress    Progress[]

  @@map("users")
}

model Question {
  id                String     @id @default(cuid())
  module            Module
  taskType          TaskType
  testType          TestType   @default(ACADEMIC)
  prompt            String
  // Task 1 chart/diagram description or image reference
  imageUrl          String?
  // topic_tag in the generation JSON contract (spec §5.3)
  topic             String?
  difficulty        Difficulty @default(MEDIUM)
  instructions      String?
  expectedWordCount Int        @default(250)
  timeLimitSeconds  Int        @default(2400)

  // Academic Task 1 only — the chart/table/process/map spec rendered on
  // the frontend (line/bar/pie/table/process/map discriminated union).
  chartSpec      Json?
  // General Task 1 only — the letter's required register.
  letterRegister LetterRegister?

  // Speaking Part 1 only — 2-3 topics x ~4 questions each (10-12 total).
  part1Topics     Json?
  // Speaking Part 2 only — the cue card's "you should say" bullet points.
  cueCardPoints   Json?
  prepSeconds     Int?
  speakingSeconds Int?
  // Speaking Part 3 only — 5-6 abstract follow-ups tied to the Part 2 cue card.
  part3FollowUps  Json?

  // sha256(normalized topic_tag + prompt), used to de-dup a user's last
  // 20 generated questions instead of repeating topic/phrasing.
  dedupeHash String?

  // Who this question was generated for (null for shared/seeded questions).
  requestedByUserId String?

  source    QuestionSource @default(GENERATED)
  // Pinned model ID that generated this question, null for seeds
  modelId   String?
  createdAt DateTime       @default(now())

  submissions           Submission[]
  mockTask1Sessions     WritingMockSession[] @relation("MockTask1Question")
  mockTask2Sessions     WritingMockSession[] @relation("MockTask2Question")
  speakingPart1Sessions SpeakingSession[]    @relation("SpeakingPart1Question")
  speakingPart2Sessions SpeakingSession[]    @relation("SpeakingPart2Question")
  speakingPart3Sessions SpeakingSession[]    @relation("SpeakingPart3Question")

  @@index([module, taskType])
  @@index([requestedByUserId, module, taskType, createdAt])
  @@map("questions")
}

model Submission {
  id         String           @id @default(cuid())
  userId     String
  questionId String
  module     Module
  status     SubmissionStatus @default(PENDING)

  // Writing
  answerText String?
  wordCount  Int?

  // Speaking
  audioUrl         String?
  transcript       String?
  durationSeconds  Int?
  // Word-level {word, start, end, confidence}[] from the STT provider.
  wordTimestamps   Json?
  // speechRateWpm, filledPauseCount, silentPauseCount, totalSilentPauseSeconds,
  // meanLengthOfRun, selfCorrectionCount — computed in code (lib/speaking/acousticFeatures.ts).
  acousticFeatures Json?

  // Aggregate results — unrounded is authoritative; the display value is the
  // officially rounded band, computed in code (lib/scoring), stored for audit.
  overallUnrounded Decimal? @db.Decimal(5, 3)
  overallBand      Decimal? @db.Decimal(2, 1)

  // The evaluator's own self-reported estimated_task_band (spec §10.2),
  // kept purely for audit/drift analysis against the code-computed band —
  // never the value that gets displayed or persisted as authoritative.
  modelSelfEstimatedBand Decimal? @db.Decimal(2, 1)

  // inline_errors[] from the evaluator's structured output (quote/issue/
  // correction/category) — a structured list with no relational reuse
  // elsewhere, so it lives as JSON rather than its own table.
  inlineErrors Json?

  // Deterministic guardrails applied in code
  wordCountPenaltyApplied Boolean @default(false)
  disagreementFlagged     Boolean @default(false)

  // Wall-clock time the candidate actually spent (writing elapsed time, or
  // spoken audio duration for Speaking) — feeds the progress dashboard's
  // "average time" metric. Reported by the client's exam timer.
  timeSpentSeconds Int?

  // Set when this submission is one half of a timed Task1+Task2 mock
  // (see WritingMockSession) rather than a standalone practice submission.
  mockSessionId     String?
  // Set when this is one of the 3 recordings (Part1/2/3) of a Speaking
  // test — which part it is is read off question.taskType, not duplicated here.
  speakingSessionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        Question            @relation(fields: [questionId], references: [id])
  mockSession     WritingMockSession? @relation(fields: [mockSessionId], references: [id])
  speakingSession SpeakingSession?    @relation(fields: [speakingSessionId], references: [id])
  scores          Score[]
  feedback        Feedback[]

  @@index([userId, createdAt])
  @@index([mockSessionId])
  @@index([speakingSessionId])
  @@map("submissions")
}

// Pairs one Task 1 + one Task 2 question into a single timed 60-minute
// mock, scored together via the 1:2 Task1:Task2 overall Writing band.
model WritingMockSession {
  id               String            @id @default(cuid())
  userId           String
  task1QuestionId  String
  task2QuestionId  String
  status           MockSessionStatus @default(IN_PROGRESS)
  timeLimitSeconds Int               @default(3600)
  startedAt        DateTime          @default(now())

  // Overall Writing band = (task1 + 2*task2) / 3, then the official
  // rounding rule — unrounded is authoritative, band is display-only.
  overallUnrounded Decimal? @db.Decimal(5, 3)
  overallBand      Decimal? @db.Decimal(2, 1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task1Question Question     @relation("MockTask1Question", fields: [task1QuestionId], references: [id])
  task2Question Question     @relation("MockTask2Question", fields: [task2QuestionId], references: [id])
  submissions   Submission[]

  @@index([userId, createdAt])
  @@map("writing_mock_sessions")
}

// Pairs Part 1 + Part 2 (cue card) + Part 3 (follow-ups tied to Part 2)
// into one Speaking test. Unlike Writing, IELTS Speaking is scored
// HOLISTICALLY across all three parts — one set of 4 criterion bands for
// the whole test, not a per-part combination formula — so the criterion
// breakdown lives here as JSON rather than per-Submission Score rows
// (which assume one task per submission, true for Writing but not Speaking).
model SpeakingSession {
  id              String            @id @default(cuid())
  userId          String
  part1QuestionId String
  part2QuestionId String
  part3QuestionId String
  status          MockSessionStatus @default(IN_PROGRESS)

  // Simple average of the 4 criteria (FC/LR/GRA/PR), then the official
  // rounding rule — unrounded is authoritative, band is display-only.
  overallUnrounded Decimal? @db.Decimal(5, 3)
  overallBand      Decimal? @db.Decimal(2, 1)

  // { criterion, band, evidence[], why }[] for FC/LR/GRA/PR.
  criteria            Json?
  // Concrete phrase-upgrade suggestions surfaced in the UI.
  upgradePhrases      Json?
  // Whether PR came from a real pronunciation API or an LLM-derived estimate.
  pronunciationSource PronunciationSource?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  part1Question Question     @relation("SpeakingPart1Question", fields: [part1QuestionId], references: [id])
  part2Question Question     @relation("SpeakingPart2Question", fields: [part2QuestionId], references: [id])
  part3Question Question     @relation("SpeakingPart3Question", fields: [part3QuestionId], references: [id])
  submissions   Submission[]

  @@index([userId, createdAt])
  @@map("speaking_sessions")
}

model Score {
  id               String    @id @default(cuid())
  submissionId     String
  // pass 1 and 2 are the raw double-pass LLM scoring calls (audit trail);
  // pass 0 is the canonical final score after averaging the two passes
  // and applying code guardrails (word-count cap, calibration ceiling) —
  // pass 0 is what overallUnrounded/overallBand are derived from.
  pass             Int       @default(1)
  criterion        Criterion
  // UNROUNDED sub-score as returned by the evaluator
  score            Decimal   @db.Decimal(3, 1)
  // Evidence quoted from the candidate's own answer + descriptor rationale
  evidence         Json
  // Pinned model ID that produced this score (audit trail)
  modelId          String
  // Descriptor/prompt/schema version (lib/scoring/evaluatorVersion.ts) —
  // bumped whenever the evaluator's scoring logic meaningfully changes.
  // Progress trend lines only ever chart same-version scores together.
  evaluatorVersion String
  createdAt        DateTime  @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, pass, criterion])
  @@map("scores")
}

model Feedback {
  id           String       @id @default(cuid())
  submissionId String
  // Null criterion = overall feedback
  criterion    Criterion?
  kind         FeedbackKind
  content      String
  createdAt    DateTime     @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("feedback")
}

model Progress {
  id     String   @id @default(cuid())
  userId String
  module Module
  // Daily rollup date (UTC midnight)
  date   DateTime @db.Date

  submissionsCount    Int      @default(0)
  // Unrounded averages for trend charts
  avgOverall          Decimal? @db.Decimal(5, 3)
  // Per-criterion unrounded averages, keyed by Criterion
  criterionAverages   Json?
  // Average timeSpentSeconds across this day's submissions.
  avgTimeSpentSeconds Int?
  // The evaluatorVersion this day's rollup was computed from — a day with
  // scores from multiple versions is stamped with the most recent one and
  // may be excluded from a trend line pinned to an older version.
  evaluatorVersion    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module, date])
  @@map("progress")
}
